# Server Configuration
PORT=3000

# Admin Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_HASH=

# Session Secret (Generate a strong random string)
SESSION_SECRET=your_random_session_secret_key_here

# Node Ingestion Token (Pre-shared key used by remote VMs to authenticate telemetry reporting)
NODE_INGEST_TOKEN=your_custom_secret_node_token_here
